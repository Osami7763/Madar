{
  "rewrites": [
    { "source": "/sources", "destination": "/index.html" },
    { "source": "/astronauts", "destination": "/index.html" },
    { "source": "/atlas", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
